# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_URL=redis://localhost:6379/0

# TimescaleDB / PostgreSQL
DATABASE_URL=postgresql+asyncpg://mds:mds_secret@localhost:5432/market_data

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-api-key-change-in-production

# Ingestion — use "simulator" for local dev, "polygon" for live data
INGESTION_SOURCE=simulator
INGESTION_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA
POLYGON_API_KEY=
SIMULATOR_TICK_INTERVAL_MS=100

# Delayed feed
DELAYED_FEED_MINUTES=15

# AI Analytics
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_WINDOW_SIZE=100

# Reconciliation
RECONCILIATION_INTERVAL_SECONDS=300
MIN_TRADES_PER_HOUR=10
MIN_QUOTES_PER_HOUR=10

# Metrics ports
INGESTION_METRICS_PORT=9101
STREAM_PROCESSOR_METRICS_PORT=9102
RECONCILIATION_METRICS_PORT=9103
AI_ANALYTICS_METRICS_PORT=9104
